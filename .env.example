# Keep this file safe to commit. Put real values in .env.local.
USE_SUPABASE=false
# Use supabase in production. Use sqlite only as an explicit local adapter.
PERSISTENCE_BACKEND=sqlite
NODE_ENV=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
MANAGE_TOKEN_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/api/auth/google/callback
PUBLIC_APP_URL=http://localhost:4173
