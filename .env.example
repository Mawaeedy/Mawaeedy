# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/api/auth/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=generate-a-32-byte-secret

# Email provider (SMTP or transactional provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Twilio SMS / WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Microsoft Graph / Outlook Calendar
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:4173/api/auth/microsoft/callback

# Apple Calendar / CalDAV
APPLE_CALDAV_URL=
APPLE_CALDAV_USERNAME=
APPLE_CALDAV_PASSWORD=
